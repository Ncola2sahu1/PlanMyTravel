# PlanMyTravel Environment Configuration Template
# Copy this file to .env and provide your actual credentials.
# NEVER commit the .env file to version control.

# Database Configuration (Turso / libSQL)
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-turso-jwt-auth-token

# AI Provider (Google Gemini) - Backend Only
# Supports multi-key configuration with automatic rotation and fallback
GEMINI_API_KEY_1=your-gemini-api-key-1
GEMINI_API_KEY_2=your-gemini-api-key-2

# Flask Configuration & Security
FLASK_ENV=production
FLASK_SECRET_KEY=generate-a-secure-random-64-character-key
SESSION_COOKIE_SECURE=true
USER_SESSION_MINUTES=1440
ADMIN_SESSION_MINUTES=120

# Admin Bootstrap Credentials
ADMIN_BOOTSTRAP_EMAIL=admin@planmytravel.com
ADMIN_BOOTSTRAP_PASSWORD=ChangeThisPasswordInProduction123!

# Travel & Accommodation Integrations
# Hotelbeds Test/Production API
HOTELBEDS_API_KEY=your-hotelbeds-api-key
HOTELBEDS_API_SECRET=your-hotelbeds-api-secret
HOTELBEDS_BASE_URL=https://api.test.hotelbeds.com

# SerpAPI Search & Discovery
SERPAPI_API_KEY=your-serpapi-key

# Flight Search & Provider (e.g. Amadeus / mock / partner aggregator)
FLIGHT_PROVIDER=test
AMADEUS_CLIENT_ID=your-amadeus-client-id
AMADEUS_CLIENT_SECRET=your-amadeus-client-secret

# Image & Media Management (Cloudinary & Local dev fallback)
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
IMAGES_DIR=/workspaces/215003575/uploads

# Trip Wallet & Payments (Razorpay)
# Operate in test mode initially
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=rzp_test_secret_placeholder
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
RAZORPAY_MODE=test
PAYMENTS_PROVIDER=razorpay
WALLET_ENABLED=true

